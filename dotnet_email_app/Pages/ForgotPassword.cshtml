@page "/forgot-password"
@model EmailApp.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="card">
    <h1>Reset your password</h1>
    <p class="muted">Enter your account email and we'll send you a link to reset your password.</p>
    <form method="post">
        @Html.AntiForgeryToken()
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" required autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <button type="submit" class="btn btn-primary">Send Reset Link</button>
    </form>
    <div class="links">
        <a href="/login">Back to login</a>
    </div>
</div>
