@page "/register"
@model EmailApp.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="card">
    <h1>Create an account</h1>
    <form method="post">
        @Html.AntiForgeryToken()
        <label asp-for="Input.Name">Name</label>
        <input asp-for="Input.Name" required autofocus />
        <span asp-validation-for="Input.Name" class="field-error"></span>

        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" required />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.Password">Password</label>
        <input asp-for="Input.Password" type="password" required minlength="8" />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
        <input asp-for="Input.ConfirmPassword" type="password" required minlength="8" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <div asp-validation-summary="All" class="field-error"></div>

        <button type="submit" class="btn btn-primary">Register</button>
    </form>
    <div class="links">
        <a href="/login">Already have an account? Log in</a>
    </div>
</div>
