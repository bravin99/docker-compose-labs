@page "/reset-password"
@model EmailApp.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Set New Password";
}

<div class="card">
    <h1>Set a new password</h1>
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Input.Code" />
        <input type="hidden" asp-for="Input.Email" />

        <label asp-for="Input.Password">New Password</label>
        <input asp-for="Input.Password" type="password" required minlength="8" autofocus />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword">Confirm New Password</label>
        <input asp-for="Input.ConfirmPassword" type="password" required minlength="8" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <div asp-validation-summary="All" class="field-error"></div>

        <button type="submit" class="btn btn-primary">Update Password</button>
    </form>
</div>
